---
import { GITHUB_URL } from '../data/site';

interface Props {
  current?: 'home' | 'posts';
}
const { current } = Astro.props;
---

<div class="nav-wrap">
  <nav class="nav" aria-label="主导航">
    <a class="brand" href="/">
      <span class="brand-mark">No rush</span>
      <span class="wordmark">
        <span class="wm-text" aria-label="不赶路"><span aria-hidden="true">不</span><span class="wm-step" aria-hidden="true">赶</span><span aria-hidden="true">路</span></span>
        <span class="wm-trail" aria-hidden="true"><i></i><i></i><i></i></span>
      </span>
    </a>
    <div class="seg">
      <a href="/" aria-current={current === 'home' ? 'page' : undefined}>首页</a>
      <a href="/posts/" aria-current={current === 'posts' ? 'page' : undefined}>文章</a>
    </div>
    <button class="icon-btn" type="button" data-theme-toggle aria-label="切换浅色/深色主题">
      <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
      <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
      </svg>
    </button>
    <a class="gh-btn" href={GITHUB_URL} target="_blank" rel="noopener">GitHub</a>
  </nav>
</div>
