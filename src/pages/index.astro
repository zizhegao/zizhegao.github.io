---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { getPosts, postLink } from '../data/posts';
import { CATEGORIES, cityColor } from '../data/site';

const posts = await getPosts();
const [lead, ...others] = posts;
const rest = others.slice(0, 4);
const count = (c: string) => posts.filter((p) => p.data.category === c).length;
const linkAttrs = (p: (typeof posts)[number]) => {
  const l = postLink(p);
  return { href: l.href, ...(l.external ? { target: '_blank', rel: 'noopener' } : {}) };
};
---

<Base current="home">
  <section class="hero">
    <div class="hero-main">
      <div class="eyebrow">Hi, I'm Zizhe</div>
      <h1>
        写 <span class="sticker tech">技术</span>、<span class="sticker essay">随笔</span><br />和
        <span class="sticker book">读书笔记</span>。
      </h1>
    </div>
    <p class="hero-aside">一个放在 GitHub Pages 上的个人角落。最近在写国庆带娃出行的方案。</p>
  </section>

  {
    lead && (
      <section class="bento">
        <a class="bento-lead" {...linkAttrs(lead)}>
          <Image src={lead.data.cover} alt="" widths={[640, 1024]} sizes="(min-width: 1024px) 50vw, 100vw" loading="eager" />
          <div class="shade">
            <span class="badge">最新 · {lead.data.when}</span>
            <h2>{lead.data.title}</h2>
            <p>{lead.data.description}</p>
          </div>
        </a>
        {rest.map((p) => (
          <a class="bento-card" {...linkAttrs(p)}>
            <Image src={p.data.cover} alt="" widths={[400, 640]} sizes="(min-width: 1024px) 25vw, 50vw" />
            <div class="meta">
              <div class="city-row">
                <span class="dot" style={`background:${cityColor(p.data.city)}`} />
                {p.data.city ?? p.data.category}
              </div>
              <div class="t">{p.data.title}</div>
            </div>
          </a>
        ))}
      </section>
    )
  }

  <section class="cats">
    {
      CATEGORIES.map((c) => (
        <div class="cat-tile" style={`background:${c.color};color:${c.fg}`}>
          <div>
            <div class="k" style={c.fg === '#fff' ? 'opacity:.85' : ''}>{c.label}</div>
            <div class="v">{count(c.label) > 0 ? c.blurb : '还没有文章，正在写'}</div>
          </div>
          <span class="n">{count(c.label)}</span>
        </div>
      ))
    }
  </section>
</Base>
